MCP_AUTH_ISSUER=https://auth.example.com
MCP_AUTH_RESOURCE=https://mcp.example.com
MCP_AUTH_LISTEN_ADDR=:8080
MCP_AUTH_PRIVATE_KEY_FILE=/run/secrets/mcp-auth-signing-key.pem
MCP_AUTH_STORE=sqlite
MCP_AUTH_DATABASE_URL=/var/lib/mcp-auth/mcp-auth.db
MCP_AUTH_CONNECTORS_FILE=/etc/mcp-auth/connectors.json
MCP_AUTH_CONNECTOR=example-oidc
MCP_AUTH_ALLOW_INSECURE_CONNECTORS=false
MCP_AUTH_REGISTRATION_ENABLED=false
# Redirect URI registered with the identity provider. Leave empty to derive it
# as <MCP_AUTH_ISSUER>/identity/callback. Set it to reuse a URI the provider
# already accepts; your ingress must route that path to this server.
MCP_AUTH_IDENTITY_CALLBACK_URL=
# OAuth Client ID Metadata Documents. A URL client_id makes this server fetch
# that URL, so the feature is opt-in. Leave the host list empty to allow any
# public host, or name a closed set.
MCP_AUTH_CLIENT_ID_METADATA_ENABLED=false
MCP_AUTH_CLIENT_ID_METADATA_HOSTS=
MCP_AUTH_LOCAL_DEVELOPMENT=false
MCP_AUTH_LOCAL_CLIENT_ID=
MCP_AUTH_LOCAL_TOKEN_EXCHANGE=false
MCP_AUTH_AUTHORIZATION_RESPONSE_ISS=true
MCP_AUTH_REQUIRE_HTTPS=true
MCP_AUTH_TRUSTED_ORIGINS=https://client.example.com
MCP_AUTH_ALLOWED_SCOPES=tools:read,tools:write
# Optional: offer Google, GitHub, LDAP and OIDC together instead of one connector.
# Replaces MCP_AUTH_CONNECTOR; see docs/login-methods.md.
# MCP_AUTH_LOGIN_METHODS_FILE=/etc/mcp-auth/login-methods.json
# MCP_AUTH_LOGIN_TTL=10m
