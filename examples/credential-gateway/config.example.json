{
  "listen": {
    "host": "0.0.0.0",
    "port": 8090
  },
  "authorization_server": {
    "issuer": "https://auth.example.com/mcp-auth"
  },
  "session_binding_key_file": "/run/secrets/gateway-session-binding",
  "form_credentials": {
    "ttl_seconds": 3600,
    "max_entries": 1024
  },
  "services": [
    {
      "id": "gitlab",
      "resource_url": "https://auth.example.com/gitlab/mcp",
      "upstream_url": "https://mcp.example.com/gitlab/mcp",
      "validation_url": "https://mcp.example.com/gitlab/mcp/auth/check",
      "required_scopes": [
        "tools:read"
      ],
      "resource_client": {
        "client_id": "gitlab-gateway",
        "key_id": "gateway-1",
        "private_key_file": "/run/secrets/gitlab-client.pem"
      },
      "form_fields": [
        {
          "name": "username",
          "label": "GitLab username"
        },
        {
          "name": "api_token",
          "label": "Personal access token",
          "secret": true
        }
      ],
      "headers": [
        {
          "name": "X-GitLab-Username",
          "type": "direct",
          "field": "username"
        },
        {
          "name": "X-GitLab-PAT-Token",
          "type": "direct",
          "field": "api_token"
        }
      ]
    }
  ]
}
